\def\D{\mathrm{d}} % differential
\def\E{\mathrm{e}} % ~ 2.7128... (base of natural logarithm)
\def\I{\mathrm{i}} % = \sqrt{-1}

\def\bigOh{\mathcal{O}} % big O notation
\newcommand\Kn{\mathrm{Kn}} % Knudsen number

% https://tex.stackexchange.com/a/33124/14751
\newcommand*{\Boltzmann}{k_{\textup{B}}} % Boltzmann's constant

% vector notation
\def\UnitNormalVec#1{\widehat{\boldsymbol{#1}}}

\DeclareMathOperator\tr{tr} % trace

\DeclareMathOperator\sgn{sgn} % signum

\let\boundary\partial
\let\bdry\boundary

% common sets
\def\RR{\mathbb{R}}

\let\tens\mathsf % tensors use sans-serif font

\let\divides\div % oblus
\let\div\relax

\newcommand\curl[1]{\vec{\nabla}\times#1}
\newcommand\div[1]{\vec{\nabla}\cdot#1} % divergence
\newcommand\gradient[1]{\vec{\nabla}#1}
\newcommand\vorticity{\vec{\omega}}


\newcommand\Rey{\mathrm{Re}} % Reynolds number
\newcommand\Fr{\mathrm{Fr}} % Froude number
\newcommand\Mach{\mathrm{M}} % Mach number
\newcommand\We{\mathrm{We}} % Weber number
\newcommand\Eu{\mathrm{Eu}} % Euler number
\newcommand\Peclet{\mathrm{Pe}} % Peclet number
\newcommand\Schmidt{\mathrm{Sc}} % Schmidt number
% special functions
\DeclareMathOperator\erf{erf}
\DeclareMathOperator\erfc{erfc}

